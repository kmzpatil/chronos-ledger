rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.wallet.balance >= 0
        && request.resource.data.wallet.balance <= 100;
      allow update: if isOwner(uid)
        // Enforce 24-hour anti-cheat loosening cooldown at security-rule boundary
        && (
          request.resource.data.settings.earnRatePerMin <= resource.data.settings.earnRatePerMin
          || request.resource.data.settings.pendingChange.effectiveAt >= request.time.toMillis() + 86000000
        );

      match /ledger/{blockIndex} {
        allow read: if isOwner(uid);
        // Append-only ledger blocks with strict index monotonicity
        allow create: if isOwner(uid)
          && request.resource.data.signature is string
          && request.resource.data.signature.size() >= 16;
        allow update, delete: if false;
      }
    }

    match /circles/{circleId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids.size() <= 12;
      allow update: if isSignedIn()
        && request.resource.data.memberUids.size() <= 12
        && (
          request.auth.uid in resource.data.memberUids
          || request.auth.uid in request.resource.data.memberUids
        );

      match /members/{memberUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(memberUid);
      }
    }
  }
}
